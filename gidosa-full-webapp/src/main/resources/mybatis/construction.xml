<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.gidosa.rdb.repositories.mysql.mybatis.ConstructionMyBatisRepository">
   <select id="findByLocationContaining" resultType="net.gidosa.rdb.models.entities.dbs.mysql.Construction">
        SELECT 
            id, name, location
        FROM 
            constructions
        WHERE 
            location LIKE CONCAT('%', #{keyword}, '%')
    </select>
</mapper>